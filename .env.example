# Secrets are stored as mode-0600 files in secrets/:
# db_password, assistant_token_secret, deepseek_api_key, backup_password
VERDICT_NOT_BEFORE=2026-08-11T00:00:00Z
# Fenêtre de rétention : dégonflage du contenu puis suppression du message.
# Les règles apprises et les directives ne sont jamais purgées.
RETENTION_ENABLED=true
RETENTION_REDACT_AFTER_DAYS=30
RETENTION_DELETE_AFTER_DAYS=180

# Exploitant de l'instance : destinataire des alertes techniques et de
# l'amorcage du fournisseur LLM. Les boites protegees, elles, se declarent
# comme domaines dans la table domains.
OPERATOR_ADDRESS=vous@votredomaine.example

# Identite de service de l'instance : adresse d'action, alias historiques,
# expediteur affiche et destinataire de la sonde de bout en bout. Ce sont les
# valeurs de repli utilisees quand la table instance_identity est vide (avant
# le premier "Reprendre la main" depuis la console) ; elles doivent pointer
# vers des adresses reellement portees par le domaine MX de l'instance.
ACTION_ADDRESS=maia@sentinel.sentimail.example
ACTION_ALIASES=kitt@sentinel.sentimail.example,maia@sentimail.example
ASSISTANT_SENDER=MAIA - SentiMail <maia@sentimail.example>
PROBE_RECIPIENT=sentinel-probe@sentimail.example

# MX public autonome (services mx / rspamd / valkey). Voir docs/mx-autonome.md.
# Nom annoncé en HELO : il doit correspondre à l'enregistrement MX publié et à
# la PTR de l'adresse publique, sinon une partie des expéditeurs refusera.
SENTINEL_V3_MX_HOSTNAME=mx.sentinel.sentimail.example
SENTINEL_V3_MX_ORIGIN=sentinel.sentimail.example
SENTINEL_V3_MX_DOMAIN=sentinel.sentimail.example
# Publication du port 25. Le défaut (127.0.0.1:2525) ne reçoit rien du monde
# et n'entre pas en conflit avec un MX déjà en écoute sur cet hôte. Une
# instance qui reçoit réellement met l'adresse publique et le port 25.
SENTINEL_V3_MX_BIND_HOST=127.0.0.1
SENTINEL_V3_MX_BIND_PORT=2525
# Arborescence de certificats montée en lecture seule sur /etc/letsencrypt.
# Laissée vide, le MX démarre avec un certificat auto-signé temporaire.
SENTINEL_V3_MX_TLS_SOURCE=sentinel_v3_mx_tls
SENTINEL_V3_MX_TLS_CERT=/etc/letsencrypt/live/mx.sentinel.sentimail.example/fullchain.pem
SENTINEL_V3_MX_TLS_KEY=/etc/letsencrypt/live/mx.sentinel.sentimail.example/privkey.pem

# Console de configuration (service admin). Elle n'a pas de mot de passe :
# l'appartenance au réseau qui porte cette adresse est l'autorisation, donc
# l'adresse de publication est la seule frontière. N'importe quelle adresse
# privée dont vous contrôlez seul l'accès convient (VPN quelconque, LAN
# filtré) ; Tailscale est le choix documenté par défaut. Jamais 0.0.0.0 ni
# une adresse publique (refusé sauf opt-in explicite via
# ADMIN_BIND_UNRESTRICTED=true). Sans cette variable, la pile ne démarre pas.
SENTINEL_ADMIN_ADDR=100.64.0.1
# Origines acceptées pour les modifications, si la console est atteinte par un
# nom (MagicDNS) plutôt que par son adresse. Vide = l'hôte de la requête.
ADMIN_TRUSTED_ORIGINS=
# Relais autorisés à déclarer l'adresse d'origine via X-Forwarded-For. Vide =
# aucun, et l'audit inscrit l'adresse du pair immédiat.
ADMIN_TRUSTED_PROXIES=
ADMIN_MESSAGES_LIMIT=100
ADMIN_EVENTS_LIMIT=50

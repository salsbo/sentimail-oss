FROM python:3.12.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

WORKDIR /app
COPY requirements.txt requirements-classifier.txt /app/
RUN pip install --no-cache-dir -r requirements.txt -r requirements-classifier.txt
COPY src /app/src
COPY tests /app/tests
RUN chmod -R a+rX /app/src /app/tests
CMD ["python", "-m", "sentimail_v3.supervision.caretaker"]
